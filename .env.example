# Copy to .env and fill in. Every variable is required, and a missing one fails the build, except
# the analytics ones: without a key the site runs with analytics off.
# Adding a variable: add it here and to the workflows, and fail loudly where it is read.

# Keystone's data layer (@keystone-sites/core): the legal pages and the analytics config.
API_URL=
API_KEY=

# Keystone's console. The homepage's composer sends a visitor to its /guest, and Log in to its /login.
# Locally, the console's dev server: http://localhost:5500
NEXT_PUBLIC_CONSOLE_URL=

# Keystone's web product analytics (@keystonepzjr/web-product-analytics): the PostHog project key for
# this environment (the development project's locally and in previews, production's when deployed),
# and its region, us (the default) or eu, which /ingest forwards to.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=
