# Copy to .env and fill in. Every variable is required; a missing one fails the build.
# Adding a variable: add it here, to the deploy workflows, and to a `required()`
# guard at its read site (see design-system/lib/grader.ts). No in-code defaults.

# Keystone data layer (@keystone-sites/core)
API_URL=
AUTH_API_URL=
API_KEY=

# Keystone Grader — the web app the grader input deep-links into.
NEXT_PUBLIC_GRADER_URL=
# The Grader search API the typeahead queries.
NEXT_PUBLIC_GRADER_API_URL=
# Search endpoint paths, tried in order (comma-separated).
NEXT_PUBLIC_GRADER_SEARCH_PATHS=
