    "test:grid": "node scripts/grid-selftest.mjs"
  },
  "dependencies": {
    "@keystone-sites/core": "^1.1.4",
    "@keystone-sites/widgets": "^1.2.5",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  }
