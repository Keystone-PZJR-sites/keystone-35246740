{
  "name": "keystone-marketing-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev --port 3340",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@keystone-sites/core": "^1.2.3",
    "@keystone-sites/services": "^1.0.3",
    "@keystone-sites/widgets": "^1.5.0",
    "@keystonepzjr/marketing-design-system": "^2.0.3",
    "@keystonepzjr/web-product-analytics": "^0.1.1",
    "next": "^16.3.4",
    "posthog-js": "^1.454.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "prettier": "^3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
