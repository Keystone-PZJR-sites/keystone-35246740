{
  "name": "keystone-marketing-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:visual": "playwright test",
    "preview": "npx opennextjs-cloudflare build && npx wrangler dev",
    "deploy": "npx opennextjs-cloudflare build && npx wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@keystone-sites/core": "^1.1.4",
    "@keystone-sites/marketing-design-system": "file:../keystone-marketing-design-system",
    "@keystone-sites/services": "^1.0.2",
    "@keystone-sites/widgets": "^1.2.5",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
